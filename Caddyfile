# miTch Pilot Deployment - Caddy Configuration

{
    # Optional: Enable local CA for automatic HTTPS on .demo domains
    # local_certs
}

# 1. Wallet PWA (Frontend)
wallet.askmi.demo {
    # The wallet must never be framed (#239). frame-ancestors cannot be set from
    # the page's <meta> policy, so it has to come from the server.
    header {
        Content-Security-Policy "frame-ancestors 'none'"
        X-Frame-Options "DENY"
    }
    reverse_proxy wallet-pwa:80
}

# 2. Verifier Backend
verifier.askmi.demo {
    reverse_proxy verifier-backend:3000
}

# 3. Mock Issuer
issuer.askmi.demo {
    reverse_proxy issuer-mock:4000
}
