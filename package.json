{
  "name": "askmi-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=!@askmi/poc-hardened",
    "build:pnpm": "pnpm -r --filter ./src/packages/* build",
    "build:topo": "pnpm -r --filter ./src/packages/* --sort build",
    "build:all": "pnpm -r --filter ./src/packages/* build && pnpm -r --filter ./src/apps/* build",
    "dev:wallet": "pnpm --filter @askmi/wallet-pwa dev",
    "dev:issuer": "pnpm --filter @askmi/issuer-mock dev",
    "dev:verifier": "pnpm --filter verifier-backend dev",
    "demo": "node scripts/dev-demo.mjs",
    "demo:smoke": "node scripts/demo-wallet-smoke.mjs",
    "dev:wallet:demo": "pnpm --filter @askmi/wallet-pwa dev:demo",
    "lint": "turbo run lint --filter=!@askmi/poc-hardened",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "guard:rebrand": "node scripts/guard-active-rebrand.mjs",
    "guard:archived-imports": "node scripts/guard-archived-imports.mjs",
    "test": "turbo run test --filter=!@askmi/poc-hardened",
    "test:golden": "pnpm --filter @askmi/integration-tests exec vitest run src/fail-closed-golden.test.ts",
    "clean": "turbo run clean",
    "clean:pnpm": "pnpm -r --filter ./src/packages/* clean",
    "evidence": "pnpm --filter @askmi/evidence exec tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "playwright": "^1.58.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.25.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "@modelcontextprotocol/sdk>ajv": "^8.12.0",
      "ajv-formats>ajv": "^8.12.0",
      "minimatch@<3.1.4": ">=3.1.4 <4",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "flatted@<3.4.2": ">=3.4.2",
      "path-to-regexp@<0.1.13": "0.1.13",
      "body-parser@<1.20.9": ">=1.20.9 <2",
      "fast-uri@<3.1.7": ">=3.1.7 <4",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.25": ">=8.5.25",
      "proxy-addr@<2.0.8": ">=2.0.8",
      "vite@<6.4.2": "6.4.2",
      "vite@>=7.0.0 <7.3.2": "7.3.2",
      "undici@>=7.0.0 <7.30.1": ">=7.30.1 <8",
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "qs@>=2.2.5 <6.16.1": ">=6.16.1",
      "hono@>=4.0.0 <4.13.16": "4.13.16",
      "ip-address@<10.7.4": ">=10.7.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "glob@>=9.0.0 <=14.0.1": "14.0.2",
      "source-map-js@<1.2.2": "1.2.2",
      "vitest@>=2.1.0 <4.1.12": "4.1.12",
      "@vitest/mocker@>=2.1.0 <4.1.12": "4.1.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "@simplewebauthn/server@<=13.3.1": "13.3.2",
      "@humanfs/node@<0.16.8": "0.16.8",
      "minimatch@>=7.0.0": ">=11.0.1",
      "@hono/node-server@<2.1.3": ">=2.1.3"
    }
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.59.0"
  }
}
