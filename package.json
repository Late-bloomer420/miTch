{
  "name": "askmi-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:pnpm": "pnpm -r --filter ./src/packages/* build",
    "build:topo": "pnpm -r --filter ./src/packages/* --sort build",
    "build:all": "pnpm -r --filter ./src/packages/* build && pnpm -r --filter ./src/apps/* build",
    "dev:wallet": "pnpm --filter @askmi/wallet-pwa dev",
    "dev:issuer": "pnpm --filter @askmi/issuer-mock dev",
    "dev:verifier": "pnpm --filter verifier-backend dev",
    "demo": "bash dev-demo.sh",
    "demo:win": "powershell -ExecutionPolicy Bypass -File dev-demo.ps1",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "guard:rebrand": "node scripts/guard-active-rebrand.mjs",
    "guard:archived-imports": "node scripts/guard-archived-imports.mjs",
    "test": "turbo run test",
    "test:golden": "pnpm --filter @askmi/integration-tests exec vitest run src/fail-closed-golden.test.ts",
    "clean": "turbo run clean",
    "clean:pnpm": "pnpm -r --filter ./src/packages/* clean",
    "evidence": "pnpm --filter @askmi/evidence exec tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "eslint": "^9.21.0",
    "playwright": "^1.58.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.25.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "@modelcontextprotocol/sdk>ajv": "^8.12.0",
      "ajv-formats>ajv": "^8.12.0",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "flatted@<3.4.2": ">=3.4.2",
      "path-to-regexp@<0.1.13": "0.1.13",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "vite@<6.4.2": "6.4.2",
      "vite@>=7.0.0 <7.3.2": "7.3.2"
    }
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  }
}
