        "lint": "tsc --noEmit"
    },
    "dependencies": {
        "@askmi/shared-types": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "rimraf": "^5.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.8"
    }
