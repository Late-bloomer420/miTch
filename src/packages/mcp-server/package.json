{
  "name": "@askmi/mcp-server",
  "version": "0.0.1",
  "type": "module",
  "description": "MCP server — exposes the AskMI policy engine to LLM agents via stdio",
  "bin": {
    "AskMI-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@askmi/policy-engine": "workspace:*",
    "@askmi/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "0.28.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  }
}
