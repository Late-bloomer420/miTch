{
  "name": "@askmi/connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/router.d.ts",
      "default": "./dist/express/router.js"
    },
    "./browser": {
      "types": "./dist/browser/handoff.d.ts",
      "default": "./dist/browser/handoff.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@askmi/oid4vp": "workspace:*",
    "@askmi/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^2.0.16",
    "@types/node": "^20.0.0",
    "express": "^4.21.2",
    "supertest": "^6.3.4",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8"
  }
}
